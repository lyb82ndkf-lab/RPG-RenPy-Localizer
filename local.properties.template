# ============================================================
# 本地签名配置模板
# 使用方法：复制此文件为 local.properties（已在 .gitignore 中排除）
# ============================================================

# DCloud AppKey（HBuilder 离线打包必需）
dcloudAppKey=your_dcloud_app_key_here

# Android 包名
androidPackage=com.rpgrtl.localizer
appVersionCode=2
appVersionName=0.2

# 签名配置
signingAlias=rpgrtl
signingKeyPassword=your_key_password_here
signingStoreFile=rpgrtl-release.keystore
signingStorePassword=your_store_password_here
