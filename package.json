{
  "name": "rpgrenpy-localizer-electron",
  "version": "3.2.0",
  "description": "Modern Electron shell for RPGRenPyLocalizer with bundled Python backend.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "build:renderer": "vite build --config electron/renderer/vite.config.mjs",
    "dist": "npm run build:renderer && electron-builder --win nsis portable",
    "pack": "npm run build:renderer && electron-builder --win dir",
    "portable": "npm run build:renderer && electron-builder --win portable"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12",
    "vite": "^8.1.5"
  },
  "build": {
    "appId": "com.rpgrenpylocalizer.desktop",
    "productName": "RPGRenPyLocalizer",
    "directories": {
      "output": "release-electron"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/renderer/dist/**/*",
      "static/**/*",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "build/electron-backend/rpgrtl-api",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "static/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RPGRenPyLocalizer",
      "installerIcon": "static/icon.ico",
      "uninstallerIcon": "static/icon.ico",
      "installerHeaderIcon": "static/icon.ico"
    },
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "43.1.1",
    "afterPack": "electron/afterPack.js"
  },
  "author": "RPGRenPyLocalizer",
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.3",
    "vue": "^3.5.40"
  }
}
